[gd_scene format=3]

[ext_resource type="Script" path="res://settings_panel.gd" id="1_settings"]
[ext_resource type="Theme" path="res://ui_theme.tres" id="2_theme"]

[node name="SettingsPanel" type="PanelContainer"]
